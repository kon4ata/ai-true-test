POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb

# для запуска приложения локально (npm run dev), без контейнеризации бэка
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/mydb_test"

JWT_SECRET=required_random_string
JWT_EXPIRES_IN_SECONDS=3600