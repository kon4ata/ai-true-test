# ---- BACKEND ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai-true-db

# для запуска приложения локально (npm run dev), без докера
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai-true-db"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/ai-true-db_test"

JWT_SECRET=required_random_string
JWT_EXPIRES_IN_SECONDS=28800


# ---- FRONTEND ----
BACKEND_URL=http://localhost:3000
SESSION_MAX_AGE=28800 # должно соответствовать переменной JWT_EXPIRES_IN_SECONDS на сервере
COOKIE_SECURE=false # false для http, true для https